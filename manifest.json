{
  "manifest_version": 3,
  "name": "Fresh Tomatoes",
  "description": "Replaces the Rotten Tomatoes audience score with the calculated unverified audience score.",
  "version": "0.1.0",
  "author": "TimothyJKennedy",
  "homepage_url": "https://github.com/TimothyJKennedy/fresh-tomatoes",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.rottentomatoes.com/m/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
